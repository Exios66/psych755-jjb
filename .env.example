# Choose provider: ollama | openrouter | mock
# Default mock for offline dry runs / CI (no network, deterministic scores).
# Set ollama or openrouter only when intentionally running a live LLM.
CA_LLM_PROVIDER=mock

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Optional OpenRouter headers
OPENROUTER_HTTP_REFERER=https://github.com/Exios66/psych755-jjb
OPENROUTER_APP_TITLE=psych755-ca-personas

# Posit Connect Cloud (JackJBurleson publish). Never commit real tokens.
# Prefer Cursor Environment Secrets for cloud agents; local agents can set these in .env.
POSIT_CONNECT_CLOUD_ACCESS_TOKEN=
POSIT_CONNECT_CLOUD_REFRESH_TOKEN=
POSIT_CONNECT_CLOUD_ACCOUNT_ID=
