# Choose provider: ollama | openrouter | mock
# Default mock for offline dry runs / CI (no network, deterministic scores).
# Set ollama or openrouter only when intentionally running a live LLM.
CA_LLM_PROVIDER=mock

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Optional OpenRouter headers
OPENROUTER_HTTP_REFERER=https://github.com/Exios66/psych755-jjb
OPENROUTER_APP_TITLE=psych755-ca-personas

# Posit Connect Cloud (JackJBurleson publish). Never commit real tokens.
# Prefer Cursor Environment Secrets for cloud agents; local agents can set these in .env.
POSIT_CONNECT_CLOUD_ACCESS_TOKEN=
POSIT_CONNECT_CLOUD_REFRESH_TOKEN=
POSIT_CONNECT_CLOUD_ACCOUNT_ID=

# Braintrust (vLLM digital-twin tracing + prompt iteration). Never commit real keys.
# When BRAINTRUST_API_KEY is set, scripts/run_vllm.sh / predict_vllm log each
# generation into a comparable experiment and may load the system prompt from
# the Braintrust prompt registry (slug below). Offline CI leaves these unset.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=psych755-ca-personas
BRAINTRUST_PROMPT_SLUG=ca-digital-twin-system
# Optional: pin a prompt version or environment (playground → production).
# BRAINTRUST_PROMPT_VERSION=
# BRAINTRUST_PROMPT_ENVIRONMENT=
# Optional: force on/off even when API key is/isn't present (true|false).
# BRAINTRUST_ENABLED=
# Optional: override auto experiment name (vllm_<model>_<preset>_<utc>).
# BRAINTRUST_EXPERIMENT=
# Optional: slim Braintrust score upload (metrics_only|slim|full).
# BRAINTRUST_SCORE_MODE=metrics_only

# Weights & Biases (vLLM digital-twin metrics). Never commit real keys.
# When WANDB_API_KEY is set, scripts/run_vllm.sh / predict_vllm log chunk
# MAE / parse_rate into a comparable W&B run (project below).
WANDB_API_KEY=
WANDB_PROJECT=psych755-ca-personas
# Optional team/user entity:
# WANDB_ENTITY=
# WANDB_ENABLED=
# WANDB_RUN_NAME=
# WANDB_MODE=online
# WANDB_TAGS=vllm,ca-digital-twin
